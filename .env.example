# ---------------------------------------------------------------------------
# CloudDisk configuration sample. Copy to `.env` and adjust.
# All values can also be supplied as real environment variables.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
APP_ENV=development
# CHANGE THIS before exposing the service. Must be at least 16 characters.
JWT_SECRET=please-change-this-secret-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12
AUTO_CREATE_TABLES=true

# --- Primary database (demo: SQLite) -----------------------------------
# Relative SQLite paths are resolved against the project root; the file and
# tables are created automatically (AUTO_CREATE_TABLES=true).
DATABASE_URL=sqlite:///data/clouddisk.db
# Optional MySQL 8 alternative (initialize sql/create_database.sql +
# sql/schema.sql first):
# DATABASE_URL=mysql+pymysql://clouddisk:clouddisk@127.0.0.1:3306/clouddisk?charset=utf8mb4

# --- Filesystem storage -------------------------------------------------
DATA_DIR=data
# Optional explicit overrides (defaults are derived from DATA_DIR):
# OBJECT_STORE_DIR=data/objects
# TEMP_DIR=data/tmp
MAX_UPLOAD_BYTES=536870912
MAX_INDEX_BYTES=2097152
MAX_INDEX_CHARS=200000

# --- Internal gRPC services --------------------------------------------
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=50051
ENABLE_SEARCH_SERVICE=true

SEMANTIC_SERVICE_HOST=127.0.0.1
SEMANTIC_SERVICE_PORT=50052
ENABLE_SEMANTIC_SERVICE=true

SEARCH_TIMEOUT_SECONDS=5
INDEX_TIMEOUT_SECONDS=30
HEALTH_TIMEOUT_SECONDS=2.0

# --- Keyword search (SQLite FTS5 + jieba) -------------------------------
SEARCH_INDEX_PATH=data/search/search_index.db
SEARCH_MAX_CANDIDATES=500
SEARCH_TITLE_WEIGHT=8.0
SEARCH_CONTENT_WEIGHT=1.0
SEARCH_TAGS_WEIGHT=3.0

# --- Semantic search (sentence-transformers + FAISS) --------------------
# auto | sentence-transformers | hash
# "auto" uses a cached sentence-transformers model (offline only) and falls
# back to the deterministic offline hashing embedder. It never downloads
# during service startup. To fetch weights explicitly, run:
#   python scripts/download_semantic_model.py
# or set SEMANTIC_EMBEDDER=sentence-transformers + allow download below.
SEMANTIC_EMBEDDER=auto
# Multilingual model (~471 MB). Smaller Chinese alternative (~95 MB):
#   BAAI/bge-small-zh-v1.5  (remember to rebuild the semantic index)
SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Set false to forbid downloading model weights at runtime.
SEMANTIC_ALLOW_MODEL_DOWNLOAD=true
# Optional explicit version label stored in index metadata.
SEMANTIC_MODEL_VERSION=
SEMANTIC_MODEL_CACHE_DIR=data/models
SEMANTIC_INDEX_PATH=data/faiss/semantic.index
SEMANTIC_INDEX_META_PATH=data/faiss/semantic_meta.json
SEMANTIC_CHUNK_SIZE=400
SEMANTIC_CHUNK_OVERLAP=80
SEMANTIC_MAX_CHUNKS=200
SEMANTIC_HASH_DIM=1024
# Minimum cosine similarity for semantic/similar results.  The offline hash
# embedder needs a slightly higher threshold to suppress hash collisions.
SEMANTIC_MIN_SCORE=0.15
# Also drop results far below the best hit (best_score * floor).
SEMANTIC_RELATIVE_SCORE_FLOOR=0.35

# --- HTTP ---------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
CORS_ORIGINS=*
FRONTEND_DIR=frontend
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
